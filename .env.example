APP_NAME=PayKaro
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Statutory interest, due windows and ageing are all computed from "today".
# PayKaro is an India-facing tool, so the workspace day boundary is IST.
APP_TIMEZONE=Asia/Kolkata

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Zero-config demo: SQLite at database/paykaro.sqlite (created by `migrate`).
# Point DB_* at MySQL/Postgres for real use — the schema is driver-agnostic.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=paykaro
# DB_USERNAME=paykaro
# DB_PASSWORD=secret

# File drivers keep the demo free of extra tables. Flip to `database` (the
# framework migrations for sessions/cache/jobs already exist) for production.
SESSION_DRIVER=file
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# ---------------------------------------------------------------------------
# PayKaro business rules (MSMED Act defaults).
# ---------------------------------------------------------------------------
PAYKARO_MSME_DUE_DAYS=45
PAYKARO_DEFAULT_TAX_RATE=18
PAYKARO_BANK_RATE=6.5
PAYKARO_INTEREST_MULTIPLIER=3
PAYKARO_FINANCE_READY_SCORE=85
PAYKARO_ALERT_LIMIT=6

# Labels the header "Demo workspace" and shows the seeded logins on the sign-in
# page. Set to false the moment this points at a real book of business.
PAYKARO_DEMO=true

# ---------------------------------------------------------------------------
# Google Sign-In (optional). Leave unset and the "Continue with Google" button
# is hidden and /auth/google* routes return 404.
# The redirect URI must be registered *exactly* in the Google Cloud Console
# under "Authorized redirect URIs". Leave it blank to derive it from the
# incoming request, which is what makes a tunneled preview work without config.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
