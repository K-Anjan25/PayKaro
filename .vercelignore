# Uploaded to Vercel as source; the PHP runtime runs `composer install` itself.
/vendor
/node_modules

# The php-wasm sandbox bridge (RUN.md) is for local agents, not for serving.
/bridge

# Never ship local state: the ledger lives in the external database, and these
# belong to this machine.
/database/*.sqlite
/data/*.sqlite
/storage/logs/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/bootstrap/cache/*.php

# Not needed to serve a request.
/tests
/phpunit.xml
/.github
