# Build context hygiene. The image installs dependencies itself; sending this
# machine's copies only makes the build slower.
.git
.github
.gitignore
.vercelignore

# Secrets and local state
.env
.env.*
!.env.example
database/*.sqlite
data/*.sqlite
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php

vendor
node_modules
bridge/node_modules

# Not needed to serve a request
tests
phpunit.xml
*.md
!README.md

# Deployment manifests for other targets
vercel.json
api
